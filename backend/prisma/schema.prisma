// ─────────────────────────────────────────
// JailMeet 2.0 — Prisma Schema
// Database: PostgreSQL
// Designed from: docs/06-prisma-database-design.md
// Legacy reference: jailmeet.sql (MySQL)
// ─────────────────────────────────────────

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// =======================
// ENUMS
// =======================

enum Role {
  ADMIN
  OFFICER
  VISITOR
  PRISONER
}

enum AppointmentStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
  CANCELLED
}

enum ParoleStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ActionType {
  CREATE
  UPDATE
  DELETE
  LOGIN
  APPROVE
  REJECT
}

enum VisitPassStatus {
  ACTIVE
  USED
  EXPIRED
  REVOKED
}

enum AppointmentChangeRequestType {
  CANCEL
  RESCHEDULE
}

enum AppointmentChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SupportCategory {
  APPOINTMENT
  PROFILE
  VISIT_PASS
  TECHNICAL
  OTHER
}

enum SupportRequestStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum PrisonerSupportCategory {
  PAROLE
  VISITATION
  CASE_SENTENCE
  PROFILE_CORRECTION
  MEDICAL_ASSISTANCE
  LEGAL_ASSISTANCE
  TECHNICAL
  OTHER
}

enum JailRuleAudience {
  VISITOR
  PRISONER
  ALL
}

// =======================
// CORE AUTH MODEL
// =======================

model User {
  id        String   @id @default(uuid())
  email     String?  @unique // Optional: Prisoners might not have email on creation
  password  String
  role      Role
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Profile Relations (One-to-One)
  adminProfile    AdminProfile?
  officerProfile  OfficerProfile?
  visitorProfile  VisitorProfile?
  prisonerProfile PrisonerProfile?

  // Utility Relations
  notifications Notification[]
  auditLogs     AuditLog[]
}

// =======================
// ROLE PROFILES
// =======================

model AdminProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name                 String
  profilePic           String?
  profileImagePublicId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  supportReplies         SupportRequest[]         @relation("AdminSupportReplies")
  prisonerSupportReplies PrisonerSupportRequest[] @relation("AdminPrisonerSupportReplies")
}

model OfficerProfile {
  id       String  @id @default(uuid())
  publicId String? @unique
  userId   String  @unique
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  name                 String
  phone                String?
  designation          String?
  department           String?
  joiningDate          DateTime? @db.Date
  shift                String?
  officeLocation       String?
  profilePic           String?
  profileImagePublicId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Workflows assigned/reviewed by this officer
  reviewedAppointments Appointment[]     @relation("OfficerReviewedAppointments")
  reviewedParoleReqs   ParoleRequest[]   @relation("OfficerReviewedParoles")
  createdPrisoners     PrisonerProfile[] @relation("OfficerCreatedPrisoners")
  reviewedChangeRequests AppointmentChangeRequest[] @relation("OfficerReviewedChangeRequests")
}

model VisitorProfile {
  id       String  @id @default(uuid())
  publicId String? @unique
  userId   String  @unique
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  name                 String
  phone                String
  state                String?
  address              String?
  city                 String?
  country              String?
  zip                  String?
  dateOfBirth          DateTime? @db.Date
  gender               String?
  profilePic           String?
  profileImagePublicId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // A visitor can request many appointments
  appointments Appointment[]
  appointmentChangeRequests AppointmentChangeRequest[]
  supportRequests           SupportRequest[]
}

model PrisonerProfile {
  id       String  @id @default(uuid())
  publicId String? @unique
  userId   String  @unique
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  name                 String
  age                  Int
  gender               String
  dateOfBirth          DateTime? @db.Date
  nationality          String?
  caseDetails          String?
  admissionDate        DateTime
  sentencePeriod       String?
  jailType             String?
  jailName             String?
  cellNumber           String?
  profilePic           String?
  profileImagePublicId String?

  // Track which officer added them to the system
  createdByOfficerId String?
  createdByOfficer   OfficerProfile? @relation("OfficerCreatedPrisoners", fields: [createdByOfficerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Prisoner entities
  appointments   Appointment[]
  paroleRequests ParoleRequest[]
  firRecords     FirRecord[]
  medicalRecords MedicalRecord[]
  supportRequests PrisonerSupportRequest[]
}

// =======================
// WORKFLOW MODELS
// =======================

model Appointment {
  id        String         @id @default(uuid())
  visitorId String
  visitor   VisitorProfile @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  prisonerId String
  prisoner   PrisonerProfile @relation(fields: [prisonerId], references: [id], onDelete: Cascade)

  // Officer who reviewed this request
  officerId String?
  officer   OfficerProfile? @relation("OfficerReviewedAppointments", fields: [officerId], references: [id], onDelete: SetNull)

  relationship  String
  message       String?
  requestedDate DateTime
  status        AppointmentStatus @default(PENDING)
  replyMessage  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visitPass      VisitPass?
  changeRequests AppointmentChangeRequest[]
}

model VisitPass {
  id            String          @id @default(uuid())
  appointmentId String          @unique
  appointment   Appointment     @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  passCode      String          @unique
  status        VisitPassStatus @default(ACTIVE)
  issuedAt      DateTime        @default(now())
  expiresAt     DateTime
  checkedInAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([status, expiresAt])
}

model AppointmentChangeRequest {
  id                  String                         @id @default(uuid())
  appointmentId       String
  appointment         Appointment                    @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  visitorId           String
  visitor             VisitorProfile                 @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  requestType         AppointmentChangeRequestType
  requestedDate       DateTime?
  reason              String
  status              AppointmentChangeRequestStatus @default(PENDING)
  pendingKey          String?                        @unique
  officerReply        String?
  reviewedByOfficerId String?
  reviewedByOfficer   OfficerProfile?                @relation("OfficerReviewedChangeRequests", fields: [reviewedByOfficerId], references: [id], onDelete: SetNull)
  reviewedAt          DateTime?
  createdAt           DateTime                       @default(now())
  updatedAt           DateTime                       @updatedAt

  @@index([visitorId, createdAt])
  @@index([status, createdAt])
}

model JailRule {
  id        String           @id @default(uuid())
  title     String
  content   String
  category  String
  audience  JailRuleAudience @default(VISITOR)
  sortOrder Int              @default(0)
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([isActive, category, sortOrder], map: "JailRule_isActive_category_sortOrder_idx")
  @@index([isActive, audience, category, sortOrder], map: "JailRule_isActive_audience_category_sortOrder_idx")
}

model SupportRequest {
  id               String               @id @default(uuid())
  visitorId        String
  visitor          VisitorProfile       @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  category         SupportCategory
  subject          String
  message          String
  status           SupportRequestStatus @default(OPEN)
  adminReply       String?
  repliedByAdminId String?
  repliedByAdmin   AdminProfile?        @relation("AdminSupportReplies", fields: [repliedByAdminId], references: [id], onDelete: SetNull)
  resolvedAt       DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([visitorId, createdAt])
  @@index([status, category, createdAt])
}

model PrisonerSupportRequest {
  id                  String                    @id @default(uuid())
  prisonerProfileId   String
  prisoner            PrisonerProfile           @relation(fields: [prisonerProfileId], references: [id], onDelete: Cascade)
  category            PrisonerSupportCategory
  subject             String
  message             String
  status              SupportRequestStatus      @default(OPEN)
  adminReply          String?
  repliedByAdminId    String?
  repliedByAdmin      AdminProfile?              @relation("AdminPrisonerSupportReplies", fields: [repliedByAdminId], references: [id], onDelete: SetNull)
  resolvedAt          DateTime?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  @@index([prisonerProfileId])
  @@index([status])
  @@index([category])
  @@index([createdAt])
}

model ParoleRequest {
  id         String          @id @default(uuid())
  prisonerId String
  prisoner   PrisonerProfile @relation(fields: [prisonerId], references: [id], onDelete: Cascade)

  // Officer who reviewed this parole
  officerId String?
  officer   OfficerProfile? @relation("OfficerReviewedParoles", fields: [officerId], references: [id], onDelete: SetNull)

  relativeName String
  relationship String
  purpose      String
  message      String?
  fromDate     DateTime
  toDate       DateTime
  status       ParoleStatus @default(PENDING)
  officerReply String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FirRecord {
  id         String          @id @default(uuid())
  prisonerId String
  prisoner   PrisonerProfile @relation(fields: [prisonerId], references: [id], onDelete: Cascade)

  firNumber   String
  description String?
  dateFiled   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MedicalRecord {
  id         String          @id @default(uuid())
  prisonerId String
  prisoner   PrisonerProfile @relation(fields: [prisonerId], references: [id], onDelete: Cascade)

  bloodGroup     String?
  allergies      String?
  checkupDetails String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =======================
// UTILITY MODELS
// =======================

model Notification {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    String  @default("GENERAL")
  title   String
  message String
  link    String?
  isRead  Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model AuditLog {
  id     String  @id @default(uuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  action   ActionType
  entity   String
  entityId String?
  details  String?

  createdAt DateTime @default(now())
}
