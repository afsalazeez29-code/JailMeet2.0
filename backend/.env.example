# JailMeet 2.0 Backend — Environment Variables

# ─────────────────────────────────────────
# Database
# ─────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/jailmeet2?schema=public"

# ─────────────────────────────────────────
# Authentication
# ─────────────────────────────────────────
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# ─────────────────────────────────────────
# Server
# ─────────────────────────────────────────
PORT=5000
NODE_ENV="development"

# ─────────────────────────────────────────
# CORS
# ─────────────────────────────────────────
CORS_ORIGIN="http://localhost:3000"
