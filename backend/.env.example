# JailMeet 2.0 Backend — Environment Variables

# ─────────────────────────────────────────
# Database
# ─────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/jailmeet2?schema=public"

# ─────────────────────────────────────────
# Authentication
# ─────────────────────────────────────────
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="5d"

# ─────────────────────────────────────────
# Server
# ─────────────────────────────────────────
PORT=5000
NODE_ENV="development"

# ─────────────────────────────────────────
# CORS
# ─────────────────────────────────────────
CORS_ORIGIN="http://localhost:3000"

# Cloudinary (signed backend operations only)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Focused four-Visitor production seed (real values belong only in .env)
SEED_FOUR_VISITORS_CONFIRM_PRODUCTION=""
SEED_VIS_001_PASSWORD=""
SEED_VIS_002_PASSWORD=""
SEED_VIS_003_PASSWORD=""
SEED_VIS_004_PASSWORD=""

# Focused ten-Prisoner production seed (real values belong only in .env)
SEED_TEN_PRISONERS_CONFIRM_PRODUCTION=""
SEED_PRN_001_PASSWORD=""
SEED_PRN_002_PASSWORD=""
SEED_PRN_003_PASSWORD=""
SEED_PRN_004_PASSWORD=""
SEED_PRN_005_PASSWORD=""
SEED_PRN_006_PASSWORD=""
SEED_PRN_007_PASSWORD=""
SEED_PRN_008_PASSWORD=""
SEED_PRN_009_PASSWORD=""
SEED_PRN_010_PASSWORD=""

# Focused four-Officer production seed (real values belong only in .env)
SEED_FOUR_OFFICERS_CONFIRM_PRODUCTION=""
SEED_OFR_001_PASSWORD=""
SEED_OFR_002_PASSWORD=""
SEED_OFR_003_PASSWORD=""
SEED_OFR_004_PASSWORD=""

# Focused Prisoner case-details production update
UPDATE_PRISONER_CASES_CONFIRM_PRODUCTION=""

# Permanent singleton Admin production seed
SEED_PERMANENT_ADMIN_CONFIRM_PRODUCTION=""
SEED_PERMANENT_ADMIN_PASSWORD=""
