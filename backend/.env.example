# JailMeet 2.0 Backend — Environment Variables

# ─────────────────────────────────────────
# Database
# ─────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/jailmeet2?schema=public"

# ─────────────────────────────────────────
# Authentication
# ─────────────────────────────────────────
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="5d"

# ─────────────────────────────────────────
# Server
# ─────────────────────────────────────────
PORT=5000
NODE_ENV="development"

# ─────────────────────────────────────────
# CORS
# ─────────────────────────────────────────
CORS_ORIGIN="http://localhost:3000"

# Cloudinary (signed backend operations only)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
