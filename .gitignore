# Ignore everything at project root
/*

# Keep only these paths
!/.gitignore
!/Frontend/
!/Frontend/**
!/backend/
!/backend/**

# Dependencies
node_modules/
**/node_modules/

# Next.js
.next/
**/.next/
out/
**/out/

# Build output
dist/
**/dist/
build/
**/build/
*.tsbuildinfo

# Environment files
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Testing
coverage/
playwright-report/
test-results/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/

# Temporary files
*.tmp
*.temp
*.bak
*.old

# Project docs and temporary AI files
docs/
jailmeet-2-docs/
**/jailmeet-2-docs/
prompt*.txt
**/prompt*.txt
